<Window x:Class="LanLink.App.Views.RemoteViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Écran distant" Width="1200" Height="780" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen" SourceInitialized="OnSourceInitialized">
    <DockPanel TextElement.Foreground="{DynamicResource TextBrush}">
        <Border x:Name="Toolbar" DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock x:Name="ModeText" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,14,0"/>
                <StackPanel x:Name="MonitorsPanel" Orientation="Horizontal" Margin="0,0,10,0"/>
                <Button x:Name="KeyboardButton" Focusable="False" Margin="0,0,6,0" Click="OnKeyboardToggle"/>
                <Button x:Name="AudioButton" Focusable="False" Margin="0,0,6,0" Click="OnAudioToggle"/>
                <Button x:Name="QualityButton" Focusable="False" Margin="0,0,6,0" Click="OnQualityCycle"/>
                <Button x:Name="FullscreenButton" Content="⛶ Plein écran" Focusable="False" Margin="0,0,6,0" Click="OnFullscreenToggle"/>
                <Button Content="⏹ Arrêter" Style="{StaticResource DangerButton}" Focusable="False" Click="OnStop"/>
            </WrapPanel>
        </Border>

        <Grid x:Name="Surface" Background="Black" Focusable="True" ClipToBounds="True"
              MouseMove="OnMouseMove" MouseDown="OnMouseDown" MouseUp="OnMouseUp" MouseWheel="OnMouseWheel">
            <Image x:Name="Screen" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" IsHitTestVisible="False"/>
            <Canvas x:Name="Overlay" IsHitTestVisible="False">
                <Polygon x:Name="CursorShape" Points="0,0 0,17 4,13 7,20 10,19 7,12 12,12" Fill="White" Stroke="Black"
                         StrokeThickness="1" Visibility="Collapsed"/>
            </Canvas>
            <TextBlock x:Name="Waiting" Text="En attente de la première image…" Foreground="#8B929C"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
    </DockPanel>
</Window>
