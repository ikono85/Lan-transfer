<Window x:Class="LanLink.App.Views.SharingBanner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="WidthAndHeight" Background="#E5734A">
    <StackPanel Orientation="Horizontal" Margin="14,7">
        <TextBlock x:Name="MessageText" Foreground="#1A0D08" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
        <Button Content="Arrêter le partage" Background="#2A1408" Foreground="#FFD9C9" Padding="12,4" Click="OnStop"/>
    </StackPanel>
</Window>
