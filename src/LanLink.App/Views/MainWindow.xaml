<Window x:Class="LanLink.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="LanLink" Width="980" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" SourceInitialized="OnSourceInitialized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="16" TextElement.Foreground="{DynamicResource TextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Colonne gauche : cet appareil + PC détectés -->
        <DockPanel Grid.Row="0" Grid.Column="0">
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="CET APPAREIL" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding DeviceName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Endpoint}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"
                               Text="{Binding FingerprintShort, StringFormat=Empreinte : {0}…}"/>
                    <Border Background="{DynamicResource InputBrush}" CornerRadius="6" Padding="8,6" Margin="0,10,0,0"
                            Visibility="{Binding ShowPasswordWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="12"
                                   Text="Définis un mot de passe dans Réglages pour pouvoir recevoir."/>
                    </Border>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PC DÉTECTÉS" Style="{StaticResource Caption}"/>
                    <ListBox ItemsSource="{Binding Peers}" SelectedItem="{Binding SelectedPeer}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- Colonne droite -->
        <DockPanel Grid.Row="0" Grid.Column="2">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="DESTINATAIRE" Style="{StaticResource Caption}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Adresse IP (choisis un PC à gauche ou saisis-la)" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding TargetAddress, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Mot de passe de ce PC" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="TargetPasswordBox" PasswordChanged="OnTargetPasswordChanged"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
        <TabControl SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="Envoyer">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
                            <StackPanel>
                                <TextBlock Text="À ENVOYER — glisse des fichiers ou dossiers ici" Style="{StaticResource Caption}"/>
                                <ListBox ItemsSource="{Binding PendingPaths}" MinHeight="90" MaxHeight="180">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Fichiers…" Command="{Binding PickFilesCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Dossier…" Command="{Binding PickFolderCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Vider" Command="{Binding ClearPendingCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Envoyer" Style="{StaticResource AccentButton}" Command="{Binding SendCommand}" Margin="0,0,8,0" MinWidth="110"/>
                                    <Button Content="Annuler" Style="{StaticResource DangerButton}" Command="{Binding CancelCommand}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" FontSize="12"
                                           Text="Un transfert interrompu reprend automatiquement là où il s'est arrêté : il suffit de renvoyer le même élément."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Discuter">
                <Border Style="{StaticResource Card}" Margin="0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnChatKeyDown"/>
                            <Button Grid.Column="1" Content="Envoyer" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                                    Command="{Binding SendChatCommand}"/>
                        </Grid>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"
                                   Text="Utilise le destinataire et le mot de passe saisis en haut."/>
                        <ListBox ItemsSource="{Binding ChatLines}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem Header="Écran distant">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="VOIR OU CONTRÔLER UN AUTRE PC" Style="{StaticResource Caption}"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                           Text="Utilise l'adresse et le mot de passe saisis en haut. L'utilisateur de l'autre PC doit accepter la demande et choisit ce qu'il autorise ; une barre orange reste affichée chez lui pendant le partage."/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <CheckBox Content="Demander le son" IsChecked="{Binding RemoteAudio}" Foreground="{DynamicResource TextBrush}" Margin="0,0,20,0"/>
                                    <CheckBox Content="Demander le presse-papiers partagé" IsChecked="{Binding RemoteClipboard}" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="👁 Voir l'écran" Command="{Binding RemoteViewCommand}" Margin="0,0,8,0" MinWidth="130"/>
                                    <Button Content="🖱 Voir et contrôler" Style="{StaticResource AccentButton}" Command="{Binding RemoteControlCommand}" MinWidth="150" Margin="0,0,8,0"/>
                                    <Button Content="Annuler" Style="{StaticResource DangerButton}" Command="{Binding CancelCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <TextBlock Style="{StaticResource Muted}" FontSize="12"
                                       Text="Limites : le bureau sécurisé de Windows (écran UAC, Ctrl+Alt+Suppr) n'est ni visible ni pilotable, et les fenêtres d'applications lancées en administrateur ne réagissent pas aux clics tant que LanLink n'est pas lui-même lancé en administrateur sur ce PC."/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Synchronisation">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <WrapPanel>
                                <Button Content="➕ Créer avec le destinataire du haut…" Style="{StaticResource AccentButton}"
                                        Command="{Binding CreateSyncCommand}" Margin="0,0,8,8"/>
                                <Button Content="🔄 Synchroniser maintenant" Command="{Binding SyncNowCommand}" Margin="0,0,8,8"/>
                                <Button Content="⏯ Pause / reprise" Command="{Binding TogglePauseSyncCommand}" Margin="0,0,8,8"/>
                                <Button Content="📂 Ouvrir le dossier" Command="{Binding OpenSyncFolderCommand}" Margin="0,0,8,8"/>
                                <Button Content="↺ Réinitialiser" Command="{Binding ResetSyncCommand}" Margin="0,0,8,8"/>
                                <Button Content="Supprimer" Style="{StaticResource DangerButton}" Command="{Binding RemoveSyncCommand}" Margin="0,0,8,8"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12"
                                       Text="Synchronisation dans les deux sens : le PC qui la crée se connecte toutes les minutes et dès qu'un fichier change ; l'autre PC choisit son dossier et accepte. Les fichiers écrasés ou supprimés sont gardés 30 jours dans .lanlink-sync\trash. Les dossiers vides ne sont pas synchronisés."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <ListBox ItemsSource="{Binding SyncPairs}" SelectedItem="{Binding SelectedSync}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                                <Run Text="{Binding Peer, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding LocalPath}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="Historique">
                <Border Style="{StaticResource Card}" Margin="0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Afficher dans l'Explorateur" Command="{Binding OpenHistoryLocationCommand}" Margin="0,0,8,0"/>
                            <Button Content="Effacer l'historique" Style="{StaticResource DangerButton}" Command="{Binding ClearHistoryCommand}"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Arrow}" Foreground="{DynamicResource AccentBrush}" FontSize="16"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Status}" HorizontalAlignment="Right" FontSize="12"/>
                                            <TextBlock Text="{Binding Time}" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem Header="Réglages">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="GÉNÉRAL" Style="{StaticResource Caption}"/>
                                <TextBlock Text="Nom de l'appareil" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,12"/>
                                <TextBlock Text="Dossier de réception" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding DownloadDirectory, UpdateSourceTrigger=LostFocus}"/>
                                    <Button Grid.Column="1" Content="Parcourir…" Margin="8,0,0,0" Command="{Binding PickDownloadDirectoryCommand}"/>
                                </Grid>
                                <TextBlock Text="Thème" Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeSystem" Content="Système" Tag="system" Click="OnThemeClick"/>
                                    <RadioButton x:Name="ThemeDark" Content="Sombre" Tag="dark" Click="OnThemeClick"/>
                                    <RadioButton x:Name="ThemeLight" Content="Clair" Tag="light" Click="OnThemeClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="PARTAGE D'ÉCRAN" Style="{StaticResource Caption}"/>
                                <CheckBox IsChecked="{Binding AllowScreenSharing}" Foreground="{DynamicResource TextBrush}"
                                          Content="Autoriser les autres PC à demander à voir ou contrôler cet écran"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                                           Text="Chaque demande exige le mot de passe puis votre accord explicite ; vous choisissez ce qui est autorisé (contrôle, presse-papiers, son)."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="MOT DE PASSE DE CE PC" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding PasswordStatus}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                                <TextBlock Text="Nouveau mot de passe (12 caractères minimum)" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="NewPasswordBox" PasswordChanged="OnNewPasswordChanged" Margin="0,0,0,10"/>
                                <TextBlock Text="Confirmation" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="ConfirmPasswordBox" PasswordChanged="OnConfirmPasswordChanged" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Enregistrer" Style="{StaticResource AccentButton}" Command="{Binding SetPasswordCommand}"/>
                                    <TextBlock Text="{Binding PasswordMessage}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"
                                           Text="Préfère une phrase de passe longue. Après 5 échecs, une adresse est bloquée 5 minutes. Les échanges sont chiffrés (TLS 1.3)."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        </DockPanel>

        <!-- Barre d'état -->
        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0"
                   Text="{Binding StatusText}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
    </Grid>
</Window>
