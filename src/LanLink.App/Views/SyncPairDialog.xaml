<Window x:Class="LanLink.App.Views.SyncPairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="Synchronisation de dossier" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        SourceInitialized="OnSourceInitialized">
    <StackPanel Margin="24" TextElement.Foreground="{DynamicResource TextBrush}">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="DetailText" Style="{StaticResource Muted}" Margin="0,6,0,0"/>

        <TextBlock Text="DOSSIER DE CE PC À SYNCHRONISER" Style="{StaticResource Caption}" Margin="0,18,0,6"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox"/>
            <Button Grid.Column="1" Content="Parcourir…" Margin="8,0,0,0" Click="OnBrowse"/>
        </Grid>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>

        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"
                   Text="Les deux dossiers seront fusionnés dans les deux sens : les fichiers manquants sont copiés, les modifications et suppressions se propagent. Tout fichier écrasé ou supprimé est gardé 30 jours dans le sous-dossier .lanlink-sync\trash."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Refuser" Margin="0,0,8,0" IsCancel="True" Click="OnRefuse"/>
            <Button Content="Accepter" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnAccept"/>
        </StackPanel>
    </StackPanel>
</Window>
