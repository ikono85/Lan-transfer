<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Thème « Néon » : noir profond, angles droits, onglets soulignés, accent dégradé cyan → violet -->

    <!-- Forme -->
    <FontFamily x:Key="UiFont">Bahnschrift, Segoe UI</FontFamily>
    <CornerRadius x:Key="CardRadius">2</CornerRadius>
    <CornerRadius x:Key="ControlRadius">2</CornerRadius>
    <Thickness x:Key="TabBorderThickness">0,0,0,2</Thickness>

    <!-- Fonds -->
    <LinearGradientBrush x:Key="BgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#05050A" Offset="0"/>
        <GradientStop Color="#0B0B16" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PanelBrush" Color="#0D0E17"/>
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#171829"/>
    <SolidColorBrush x:Key="InputBrush" Color="#05050A"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#1A1B2C"/>

    <!-- Contours -->
    <SolidColorBrush x:Key="BorderBrush" Color="#25273D"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="#0D0E17"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3A3D5C"/>

    <!-- Texte -->
    <SolidColorBrush x:Key="TextBrush" Color="#F2F3FA"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#7E8299"/>

    <!-- Accent : dégradé cyan → violet -->
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00E5FF" Offset="0"/>
        <GradientStop Color="#A855F7" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#05050A"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF4D6D"/>

    <!-- Onglet sélectionné : fond transparent, soulignement accent -->
    <SolidColorBrush x:Key="TabSelectedBrush" Color="Transparent"/>
</ResourceDictionary>
