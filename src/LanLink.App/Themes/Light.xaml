<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Forme -->
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <CornerRadius x:Key="CardRadius">10</CornerRadius>
    <CornerRadius x:Key="ControlRadius">7</CornerRadius>
    <Thickness x:Key="TabBorderThickness">0</Thickness>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TabSelectedBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="BgBrush" Color="#F3F5F7"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#E8ECEF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D8DDE2"/>
    <SolidColorBrush x:Key="InputBrush" Color="#F7F9FA"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="#E3E7EB"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1B2025"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#66707B"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#12A56B"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C8481F"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#DDE2E7"/>
</ResourceDictionary>
